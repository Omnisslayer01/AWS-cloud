#!/usr/bin/env bash

if [ -z "$1" ]; then
    echo "Enter the Bucket name"
    exit 1
fi

if [ -z "$2" ]; then
    echo "Enter file name/key"
    exit 1
fi

if [ -z "$3" ]; then
    echo "Enter body"
    exit 1
fi

bucket_name=$1
key=$2
body=$3

aws s3api put-object --bucket $bucket_name --key $key --body $body
#!/usr/bin/env bash

if [ -z "$1" ]; then
    echo "Enter folder path that you want to upload to S3 ex. ./my-folder"
    exit 1
fi

if [ -z "$1" ]; then
    echo "Enter Bucket-name/my-folder to upload the folder and its contents to"
    exit 1
fi

folder_name=$1
bucket_name=$2
aws s3 sync $folder_name s3://$bucket_name/$folder_name